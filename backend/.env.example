# Copy this file to ".env" in the backend/ folder and fill in your own values.
# Never commit the real .env file.

FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string

# --- MySQL (XAMPP defaults shown) ---
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=retailinsight

# --- Frontend URL (used to build password reset links) ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Mail (optional at first — leave blank and password reset emails
# will just be logged to the console instead of sent) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@retailinsight.local
